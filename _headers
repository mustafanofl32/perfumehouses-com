# Static art does not change without also changing its name, so it can sit in the
# browser cache instead of being revalidated on every visit. The stylesheet carries a
# content hash in its query string, so it can be immutable.
/assets/scenes/*
  Cache-Control: public, max-age=2592000
/assets/brand/*
  Cache-Control: public, max-age=2592000
/assets/img/*
  Cache-Control: public, max-age=2592000
/assets/site.css
  Cache-Control: public, max-age=31536000, immutable
