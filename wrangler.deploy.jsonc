{
  "main": "worker.js",
  "name": "perfumehouses-official",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "routes": [
    { "pattern": "perfumehouses.com", "custom_domain": true },
    { "pattern": "www.perfumehouses.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "../ph-dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
